   _defaultTextAttributes = defaultTextAttributes;
-  self.typingAttributes = defaultTextAttributes;
+  NSDictionary<NSAttributedStringKey, id> *attributesForUIKit = RCTTextInputAttributesForUIKit(defaultTextAttributes);
+  // UIKit から見て中身が変わっていなければ設定し直さない(変換中の下線が消えるため。RCTUITextField.mm 参照)。
+  if (![previousForUIKit isEqualToDictionary:attributesForUIKit]) {
+    self.typingAttributes = attributesForUIKit;
+  }
   [self _updatePlaceholder];
 }
 
