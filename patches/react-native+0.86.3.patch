 #import <React/RCTBackedTextInputDelegateAdapter.h>
 #import <React/RCTTextAttributes.h>
 
+// 日本語などのIME変換中の文字の下線は、UIKit に渡す defaultTextAttributes / typingAttributes に
+// 「影響のない NSShadow」「背景色(NSBackgroundColor)」「React内部の EventEmitter キー」が
+// 含まれていると描画されなくなる(New Architecture の既知の不具合: facebook/react-native#55257)。
+// どれも TextInput の見た目や動作には不要(背景はビュー自体が描く。EventEmitter は React 側が
+// 自前の defaultTextAttributes のコピーから読む)ので、UIKit に渡す前に取り除く。
+static NSDictionary<NSAttributedStringKey, id> *RCTTextInputAttributesForUIKit(
+    NSDictionary<NSAttributedStringKey, id> *attributes)
+{
+  if (attributes == nil) {
+    return nil;
+  }
+
+  NSMutableDictionary<NSAttributedStringKey, id> *filtered = [attributes mutableCopy];
+  [filtered removeObjectForKey:@"EventEmitter"];
+  [filtered removeObjectForKey:NSBackgroundColorAttributeName];
+
+  NSShadow *shadow = filtered[NSShadowAttributeName];
+  if ([shadow isKindOfClass:[NSShadow class]] && CGSizeEqualToSize(shadow.shadowOffset, CGSizeZero) &&
+      shadow.shadowBlurRadius == 0) {
+    [filtered removeObjectForKey:NSShadowAttributeName];
+  }
+
+  return filtered;
+}
